# Sao chép file này thành "secrets.yaml" và điền thông tin thật của bạn.
# TUYỆT ĐỐI KHÔNG commit file secrets.yaml lên Git.

# Your Wi-Fi SSID and password
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Mật khẩu cho hotspot dự phòng (tối thiểu 8 ký tự)
ap_password: "YOUR_AP_PASSWORD"

# Khóa mã hóa API (base64, 32 byte) — tạo bằng: openssl rand -base64 32
api_encryption_key: "YOUR_API_ENCRYPTION_KEY"

# Mật khẩu cập nhật OTA
ota_password: "YOUR_OTA_PASSWORD"
